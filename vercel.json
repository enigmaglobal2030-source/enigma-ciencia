{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/img/(.*)",
      "destination": "/img/$1"
    },
    {
      "source": "/(.*)\\.webp$",
      "destination": "/$1.webp"
    },
    {
      "source": "/(.*)\\.png$",
      "destination": "/$1.png"
    },
    {
      "source": "/(.*)\\.jpg$",
      "destination": "/$1.jpg"
    },
    {
      "source": "/(.*)\\.svg$",
      "destination": "/$1.svg"
    }
  ]
}
